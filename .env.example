APP_ENV=production

# Configure at least one provider. The callback must match its OAuth application.
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GITHUB_CALLBACK_URL=https://example.test/auth/github/callback
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=https://example.test/auth/google/callback
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_CALLBACK_URL=https://example.test/auth/microsoft/callback
# AUTH_DISCORD_CLIENT_ID=
# AUTH_DISCORD_CLIENT_SECRET=
# AUTH_DISCORD_CALLBACK_URL=https://example.test/auth/discord/callback
# Optional database-less fallback only; never use login or email.
# AUTH_ADMIN_IDENTITIES=github:123456789
# SESSION_IDLE_SECONDS=1800
# SESSION_ABSOLUTE_SECONDS=28800

# mysql (also used for MariaDB) or pgsql (PostgreSQL)
DATABASE_ENGINE=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=miniportal
DATABASE_USER=miniportal
DATABASE_PASSWORD=change-me
