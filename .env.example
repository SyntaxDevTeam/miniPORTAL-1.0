MINIPORTAL_ENV=production

# Configure at least one provider. The callback must match its OAuth application.
# MINIPORTAL_AUTH_GITHUB_CLIENT_ID=
# MINIPORTAL_AUTH_GITHUB_CLIENT_SECRET=
# MINIPORTAL_AUTH_GITHUB_CALLBACK_URL=https://example.test/auth/github/callback
# MINIPORTAL_AUTH_GOOGLE_CLIENT_ID=
# MINIPORTAL_AUTH_GOOGLE_CLIENT_SECRET=
# MINIPORTAL_AUTH_GOOGLE_CALLBACK_URL=https://example.test/auth/google/callback
# MINIPORTAL_AUTH_MICROSOFT_CLIENT_ID=
# MINIPORTAL_AUTH_MICROSOFT_CLIENT_SECRET=
# MINIPORTAL_AUTH_MICROSOFT_CALLBACK_URL=https://example.test/auth/microsoft/callback
# MINIPORTAL_AUTH_DISCORD_CLIENT_ID=
# MINIPORTAL_AUTH_DISCORD_CLIENT_SECRET=
# MINIPORTAL_AUTH_DISCORD_CALLBACK_URL=https://example.test/auth/discord/callback
# Stable provider subjects allowed during bootstrap; never use login or email.
# MINIPORTAL_AUTH_ADMIN_IDENTITIES=github:123456789
# MINIPORTAL_SESSION_IDLE_SECONDS=1800
# MINIPORTAL_SESSION_ABSOLUTE_SECONDS=28800

# mysql (also used for MariaDB) or pgsql (PostgreSQL)
MINIPORTAL_DATABASE_ENGINE=mysql
MINIPORTAL_DATABASE_HOST=127.0.0.1
MINIPORTAL_DATABASE_PORT=3306
MINIPORTAL_DATABASE_NAME=miniportal
MINIPORTAL_DATABASE_USER=miniportal
MINIPORTAL_DATABASE_PASSWORD=change-me
