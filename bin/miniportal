#!/usr/bin/env php
<?php

declare(strict_types=1);

use SyntaxDevTeam\MiniPortal\Core\Diagnostics\Doctor;

require dirname(__DIR__) . '/vendor/autoload.php';

$command = $argv[1] ?? 'help';
$projectRoot = dirname(__DIR__);

if ($command === 'doctor' || $command === 'verify-runtime') {
    $doctor = new Doctor($projectRoot);
    foreach ($doctor->checks() as $check) {
        printf("[%s] %-18s %s\n", $check->ok ? 'OK' : 'FAIL', $check->name, $check->detail);
    }
    exit($doctor->isHealthy() ? 0 : 1);
}

fwrite(
    STDOUT,
    "miniPORTAL 1.0 CLI\n\nUsage:\n  bin/miniportal doctor\n  bin/miniportal verify-runtime\n",
);
exit($command === 'help' ? 0 : 2);
