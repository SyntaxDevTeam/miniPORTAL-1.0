#!/usr/bin/env php
<?php

declare(strict_types=1);

use SyntaxDevTeam\MiniPortal\Application\TrustedSystemPackageSeeder;
use SyntaxDevTeam\MiniPortal\Core\Api\ServiceTokenStore;
use SyntaxDevTeam\MiniPortal\Core\Diagnostics\Doctor;
use SyntaxDevTeam\MiniPortal\Core\Package\Dependency\DependencyResolver;
use SyntaxDevTeam\MiniPortal\Core\Package\Lifecycle\PackageLifecycleManager;
use SyntaxDevTeam\MiniPortal\Core\Package\Manifest\ManifestParser;
use SyntaxDevTeam\MiniPortal\Core\Package\Preflight\PackagePreflightService;
use SyntaxDevTeam\MiniPortal\Core\Package\Registry\PackageRegistry;
use SyntaxDevTeam\MiniPortal\Module\SystemThemes\SystemThemesModule;
use SyntaxDevTeam\MiniPortal\Migration\Legacy\IdentityImporter;
use SyntaxDevTeam\MiniPortal\Core\Diagnostics\AuthenticationReadiness;
use SyntaxDevTeam\MiniPortal\Core\Kernel\CompositionRoot;
use SyntaxDevTeam\MiniPortal\Core\Kernel\Runtime;
use SyntaxDevTeam\MiniPortal\Core\Migration\CoreMigrationCatalog;
use SyntaxDevTeam\MiniPortal\Library\Storage\Contract\Database;
use SyntaxDevTeam\MiniPortal\Library\Storage\Migration\DatabaseMigrationLedger;
use SyntaxDevTeam\MiniPortal\Library\Storage\Migration\MigrationPlanner;
use SyntaxDevTeam\MiniPortal\Library\Storage\Migration\MigrationRunner;

require dirname(__DIR__) . '/vendor/autoload.php';

$command = $argv[1] ?? 'help';
$projectRoot = dirname(__DIR__);

if ($command === 'doctor' || $command === 'verify-runtime') {
    $doctor = new Doctor($projectRoot);
    foreach ($doctor->checks() as $check) {
        printf("[%s] %-18s %s\n", $check->ok ? 'OK' : 'FAIL', $check->name, $check->detail);
    }
    exit($doctor->isHealthy() ? 0 : 1);
}

if ($command === 'auth:status') {
    $runtime = Runtime::boot();
    $readiness = new AuthenticationReadiness($runtime->config);
    foreach ($readiness->checks() as $check) {
        printf("[%s] %-18s %s\n", $check->ok ? 'OK' : 'FAIL', $check->name, $check->detail);
    }
    exit($readiness->isReady() ? 0 : 1);
}

if ($command === 'migrations:plan' || $command === 'migrations:apply') {
    $runtime = Runtime::boot();
    $services = (new CompositionRoot())->build($runtime);
    if (!$services->has(Database::class)) {
        fwrite(STDERR, "Database configuration is required. Copy .env.example to .env and configure it.\n");
        exit(2);
    }
    $database = $services->get(Database::class);
    $catalog = $services->get(CoreMigrationCatalog::class);
    if (!$database instanceof Database || !$catalog instanceof CoreMigrationCatalog) {
        throw new LogicException('Migration services have invalid types.');
    }

    $ledger = new DatabaseMigrationLedger($database);
    $planner = new MigrationPlanner($database, $ledger);
    $runner = new MigrationRunner($database, $ledger);
    $exitCode = 0;
    foreach ($catalog->byOwner() as $ownerId => $migrations) {
        $plan = $planner->plan($ownerId, $migrations);
        printf("[%s] %s: %d pending\n", $plan->executable() ? 'OK' : 'BLOCKED', $ownerId, count($plan->pending()));
        foreach ($plan->blockingReasons as $reason) {
            printf("  - %s\n", $reason);
        }
        if (!$plan->executable()) {
            $exitCode = 1;
            continue;
        }
        if ($command === 'migrations:apply' && $plan->pending() !== []) {
            $result = $runner->apply($plan);
            printf("  applied: %s\n", implode(', ', $result->appliedMigrationIds));
        }
    }
    exit($exitCode);
}

if ($command === 'legacy:plan' || $command === 'legacy:apply') {
    $snapshot = stream_get_contents(STDIN, 5_000_001);
    if (!is_string($snapshot)) {
        fwrite(STDERR, "Unable to read legacy snapshot.\n");
        exit(2);
    }
    $runtime = Runtime::boot();
    $services = (new CompositionRoot())->build($runtime);
    if (!$services->has(Database::class)) {
        fwrite(STDERR, "Target database is not configured.\n");
        exit(2);
    }
    $database = $services->get(Database::class);
    if (!$database instanceof Database) {
        throw new LogicException('Database service has invalid type.');
    }
    try {
        $importer = new IdentityImporter($database);
        $plan = $command === 'legacy:plan'
            ? $importer->plan($snapshot)
            : $importer->apply($snapshot, $argv[2] ?? '');
        printf("[%s] users=%d identities=%d roles=%d permissions=%d user_roles=%d role_permissions=%d checksum=%s\n",
            $command === 'legacy:plan' ? 'PLAN' : 'APPLIED',
            $plan->users, $plan->identities, $plan->roles, $plan->permissions,
            $plan->userRoles, $plan->rolePermissions, $plan->checksum);
        exit(0);
    } catch (Throwable $exception) {
        fwrite(STDERR, "Legacy identity import blocked: " . $exception->getMessage() . "\n");
        exit(1);
    }
}

if ($command === 'api:token:issue' || $command === 'api:token:revoke') {
    $runtime = Runtime::boot();
    $services = (new CompositionRoot())->build($runtime);
    if (!$services->has(ServiceTokenStore::class)) {
        fwrite(STDERR, "API token storage requires a configured database.\n");
        exit(2);
    }
    $store = $services->get(ServiceTokenStore::class);
    if (!$store instanceof ServiceTokenStore) {
        throw new LogicException('API token store has an invalid type.');
    }
    try {
        if ($command === 'api:token:revoke') {
            $store->revoke($argv[2] ?? '');
            fwrite(STDOUT, "[OK] Token revoked.\n");
            exit(0);
        }
        $scopes = array_values(array_filter(explode(',', $argv[2] ?? '')));
        $days = $argv[3] ?? '30';
        if (preg_match('/^[1-9][0-9]{0,2}$/D', $days) !== 1 || (int) $days > 365) {
            throw new InvalidArgumentException('Token lifetime must be 1–365 days.');
        }
        $expires = new DateTimeImmutable('+' . $days . ' days', new DateTimeZone('UTC'));
        $issued = $store->issue($scopes, $expires);
        printf("Token ID: %s\nSecret (shown once): %s\n", $issued->id, $issued->secret);
        exit(0);
    } catch (Throwable $exception) {
        fwrite(STDERR, "API token command failed: " . $exception->getMessage() . "\n");
        exit(1);
    }
}

if ($command === 'packages:seed-system-themes') {
    $runtime = Runtime::boot();
    $services = (new CompositionRoot())->build($runtime);
    if (!$services->has(Database::class)) {
        fwrite(STDERR, "Database configuration is required.\n");
        exit(2);
    }
    $database = $services->get(Database::class);
    $registry = $services->get(PackageRegistry::class);
    $parser = $services->get(ManifestParser::class);
    $resolver = $services->get(DependencyResolver::class);
    $lifecycle = $services->get(PackageLifecycleManager::class);
    $preflight = $services->get(PackagePreflightService::class);
    if (!$database instanceof Database || !$registry instanceof PackageRegistry
        || !$parser instanceof ManifestParser || !$resolver instanceof DependencyResolver
        || !$lifecycle instanceof PackageLifecycleManager || !$preflight instanceof PackagePreflightService) {
        throw new LogicException('Package services have invalid types.');
    }
    $ledger = new DatabaseMigrationLedger($database);
    $catalog = new CoreMigrationCatalog();
    $packagePlan = (new MigrationPlanner($database, $ledger))->plan(
        'core.packages', $catalog->byOwner()['core.packages'],
    );
    if (!$packagePlan->executable() || $packagePlan->pending() !== []) {
        fwrite(STDERR, "Package registry migration is pending or blocked. Run migrations:plan, then migrations:apply.\n");
        exit(2);
    }
    try {
        $release = (new TrustedSystemPackageSeeder($parser, $resolver, $registry, $lifecycle, $preflight))
            ->seed($projectRoot . '/modules/SystemThemes/manifest.json', 'system.themes', SystemThemesModule::class);
        printf("[OK] %s@%s: %s\n", $release->manifest->id, $release->manifest->version, $release->state->value);
        exit(0);
    } catch (Throwable $exception) {
        fwrite(STDERR, "System module activation failed: " . $exception->getMessage() . "\n");
        exit(1);
    }
}

fwrite(
    STDOUT,
    "miniPORTAL 1.0 CLI\n\nUsage:\n  bin/miniportal doctor\n  bin/miniportal verify-runtime\n  bin/miniportal auth:status\n  bin/miniportal migrations:plan\n  bin/miniportal migrations:apply\n  bin/miniportal packages:seed-system-themes\n  bin/miniportal api:token:issue SCOPE[,SCOPE] [DAYS]\n  bin/miniportal api:token:revoke TOKEN_ID\n  bin/miniportal legacy:plan < snapshot.json\n  bin/miniportal legacy:apply CHECKSUM < snapshot.json\n",
);
exit($command === 'help' ? 0 : 2);
